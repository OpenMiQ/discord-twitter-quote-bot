{
  "name": "discord-twitter-quote-bot",
  "type": "module",
  "version": "1.0.0",
  "description": "A Discord bot to quote tweet.",
  "author": "otoneko.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OpenMiQ/discord-twitter-quote-bot#readme",
  "bugs": {
    "url": "https://github.com/OpenMiQ/discord-twitter-quote-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMiQ/discord-twitter-quote-bot.git"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.mjs",
    "register": "node dist/register.mjs",
    "format": "prettier --write ./src ./tests",
    "format:check": "prettier --check ./src ./tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run format && npm run lint:fix"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "ky": "^2.0.2",
    "makeitaquote": "^8.0.1"
  }
}
